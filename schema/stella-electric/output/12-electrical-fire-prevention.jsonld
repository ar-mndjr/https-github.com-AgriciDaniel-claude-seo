    {
      "@type": "FAQPage",
      "@id": "https://stellaelectricllc.com/electrical-fire-prevention/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/electrical-fire-prevention/#faq-1",
          "name": "What causes most electrical fires in homes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Faulty or deteriorated wiring and connections, overloaded circuits, damaged cords and plugs, misused extension cords and power strips, over-lamped or failing light fixtures, and space heaters on circuits that cannot carry them."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/electrical-fire-prevention/#faq-2",
          "name": "What are the warning signs of an electrical fire risk?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A burning or fishy smell near outlets or the panel, scorch marks or discoloration on outlets and switch plates, outlets or plates that feel warm, buzzing or crackling, breakers that trip repeatedly, lights that flicker or dim when appliances start, and a panel that is warm or rusted."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/electrical-fire-prevention/#faq-3",
          "name": "Do AFCI breakers really prevent fires?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Arc-fault circuit interrupters are designed to detect arcing that a standard breaker cannot - a loose terminal, a nicked conductor, a cord crushed under a chair leg - and cut power before that arc ignites what is around it. That is why the code has extended AFCI protection to most living-area circuits."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/electrical-fire-prevention/#faq-4",
          "name": "How often should home wiring be inspected?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Have the electrical system evaluated when you buy a home, before a major renovation, after any signs of trouble, and periodically for homes over about 40 years old. Older wiring, aluminum branch circuits and recalled panels warrant an inspection regardless of symptoms."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/electrical-fire-prevention/#faq-5",
          "name": "What should I do if I smell burning near an outlet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Shut off the circuit at the breaker - the main breaker if you cannot identify the circuit - keep people away from the area, and call an electrician. If there is smoke or flame, get everyone out and call 911 first."
          }
        }
      ]
    },
    {
      "@type": "ItemList",
      "@id": "https://stellaelectricllc.com/electrical-fire-prevention/#itemlist",
      "name": "How to prevent an electrical fire at home",
      "itemListOrder": "https://schema.org/ItemListOrderAscending",
      "numberOfItems": 8,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Stop overloading circuits",
          "description": "Power strips and extension cords used as permanent wiring are the most common overload. A circuit that needs a strip to keep up usually needs another circuit."
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Replace damaged cords and devices",
          "description": "Frayed insulation, cracked plugs, and cords run under rugs or pinched by furniture all fail in the same place - where nobody can see the damage."
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Act on warm outlets and switches",
          "description": "Outlets and switch plates should never be warm. Heat means a loose connection or an overloaded circuit, and both arc before they ignite."
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Investigate breakers that trip repeatedly",
          "description": "A breaker that trips is doing its job. One that trips over and over is reporting a fault that has not been fixed."
        },
        {
          "@type": "ListItem",
          "position": 5,
          "name": "Add AFCI protection",
          "description": "Arc-fault breakers detect the low-level arcing that a standard breaker never sees, which is the exact failure mode behind most wiring fires."
        },
        {
          "@type": "ListItem",
          "position": 6,
          "name": "Use the right bulb wattage and fixtures",
          "description": "Over-lamping a fixture bakes the socket and the wiring above it. Match the fixture's rating, and use fixtures rated for enclosed or insulated ceilings."
        },
        {
          "@type": "ListItem",
          "position": 7,
          "name": "Have old wiring and panels evaluated",
          "description": "Knob-and-tube, deteriorated cloth insulation, aluminum branch circuits and recalled panel brands all carry a documented fire history."
        },
        {
          "@type": "ListItem",
          "position": 8,
          "name": "Keep working smoke alarms",
          "description": "Prevention fails sometimes. Interconnected alarms on every level and in every bedroom are what turn a fire into an evacuation instead of a tragedy."
        }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://stellaelectricllc.com/electrical-fire-prevention/#service",
      "name": "Electrical Safety Inspection",
      "serviceType": "Electrical safety inspection",
      "description": "Whole-home electrical safety evaluation covering panel condition, wiring, connections, circuit protection and fire risk, with a written report and repair recommendations.",
