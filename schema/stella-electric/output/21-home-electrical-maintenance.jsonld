    {
      "@type": "FAQPage",
      "@id": "https://stellaelectricllc.com/home-electrical-maintenance/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/home-electrical-maintenance/#faq-1",
          "name": "What does home electrical maintenance involve?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Regular testing of smoke alarms and GFCI devices, a look at outlets, switches and cords for heat or damage, seasonal checks of the panel and outdoor equipment, and a periodic professional inspection of the connections, grounding and circuit loading behind the walls."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/home-electrical-maintenance/#faq-2",
          "name": "How often should I have my electrical system inspected?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every three to five years for a typical home, annually for homes with older wiring or heavy loads, and additionally when buying or selling, before a major renovation, and after any storm or water damage to electrical equipment."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/home-electrical-maintenance/#faq-3",
          "name": "What electrical maintenance can I do myself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Testing alarms and GFCIs, checking for warm or discolored devices, replacing bulbs within the fixture's rating, keeping the panel accessible and labeled, and keeping cords out from under rugs and furniture. Anything requiring the panel cover to come off belongs to an electrician."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/home-electrical-maintenance/#faq-4",
          "name": "Why does the panel need to be checked if nothing is wrong?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because connections loosen with thermal cycling, and a loose connection heats long before it trips a breaker. Torque checks, grounding and bonding verification and load balancing are preventive work - they find the failure while it is still a maintenance item."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/home-electrical-maintenance/#faq-5",
          "name": "Is an electrical maintenance plan worth it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is worth it when it catches the loose connection, the failed GFCI or the aging alarm before they become an emergency call. The value is in the schedule being kept rather than in any single visit."
          }
        }
      ]
    },
    {
      "@type": "ItemList",
      "@id": "https://stellaelectricllc.com/home-electrical-maintenance/#itemlist",
      "name": "Home electrical maintenance schedule",
      "itemListOrder": "https://schema.org/ItemListOrderAscending",
      "numberOfItems": 8,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Monthly - test smoke and CO alarms",
          "description": "Press the test button on every unit and confirm interconnected alarms all sound."
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Monthly - test GFCI devices",
          "description": "Press TEST and RESET on every GFCI receptacle and breaker. A device that will not trip has failed."
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Quarterly - walk the outlets and cords",
          "description": "Check for warm or discolored outlets, loose receptacles, damaged cords, and power strips doing the work of permanent circuits."
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Twice a year - vacuum alarms and check bulbs",
          "description": "Dust in an alarm chamber causes both missed detections and nuisance trips. Confirm fixtures are within their wattage rating."
        },
        {
          "@type": "ListItem",
          "position": 5,
          "name": "Annually - check the panel and outdoor equipment",
          "description": "Look for rust, moisture, burning smells or warmth at the panel, and check that outdoor covers, boxes and the service mast are intact."
        },
        {
          "@type": "ListItem",
          "position": 6,
          "name": "Annually - exercise and inspect the generator",
          "description": "Standby and portable generator equipment, transfer switches and their connections need a run and an inspection before storm season."
        },
        {
          "@type": "ListItem",
          "position": 7,
          "name": "Every 10 years - replace smoke alarms and GFCIs",
          "description": "Both age out on a schedule the test button cannot reveal. Replace by manufacture date, not by symptom."
        },
        {
          "@type": "ListItem",
          "position": 8,
          "name": "Every few years - a professional inspection",
          "description": "A licensed electrician checks terminations, torque, grounding, bonding and circuit loading - the things that cannot be seen from the living side of the wall."
        }
      ]
    },
    {
