    {
      "@type": "FAQPage",
      "@id": "https://stellaelectricllc.com/electrical-load-calculation/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/electrical-load-calculation/#faq-1",
          "name": "What is an electrical load calculation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is the calculation that determines how much electrical capacity a home actually needs, based on square footage, required branch circuits, and the nameplate ratings of the appliances and equipment installed. It is what tells you whether a 100-amp service is still adequate or whether the home needs 200 amps."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/electrical-load-calculation/#faq-2",
          "name": "When do I need a load calculation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Before adding significant load - an EV charger, a heat pump, central air, an electric range replacing gas, a hot tub, an addition or a finished basement - and before any service upgrade. Permit offices routinely require one with the application."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/electrical-load-calculation/#faq-3",
          "name": "Can I do a load calculation myself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can work through the standard method to get a rough idea of where your home stands. The calculation that goes on a permit application, and the decision about service size, should come from a licensed electrician who will also account for the existing panel, the service conductors and the code edition your jurisdiction has adopted."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/electrical-load-calculation/#faq-4",
          "name": "Does adding an EV charger require a load calculation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. An EV charger is a large continuous load, and the calculation determines whether the existing service can carry it, whether load management is needed, or whether the panel and service have to be upgraded first."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/electrical-load-calculation/#faq-5",
          "name": "What size electrical service does a house need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends entirely on the calculation. A modest home with gas heat, gas cooking and no central air can still be fine on 100 amps; a home with electric heat, central air, an EV charger or a large addition generally needs 200 amps or more."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://stellaelectricllc.com/electrical-load-calculation/#howto",
      "name": "How a Residential Electrical Load Calculation Works",
      "description": "The standard method from NEC Article 220 for determining how much electrical service a home needs.",
      "totalTime": "PT1H",
      "image": {
        "@id": "https://stellaelectricllc.com/electrical-load-calculation/#primaryimage"
      },
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Measure the conditioned floor area",
          "text": "Take the square footage of the living space, excluding open porches, garages and unfinished areas not adaptable for future use.",
          "url": "https://stellaelectricllc.com/electrical-load-calculation/#step-1"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Add the general lighting and receptacle load",
          "text": "The standard method assigns 3 volt-amperes per square foot for general lighting and general-use receptacles.",
          "url": "https://stellaelectricllc.com/electrical-load-calculation/#step-2"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Add the required branch circuits",
          "text": "Add 1,500 VA for each of the two or more small-appliance branch circuits required in the kitchen, and 1,500 VA for the laundry circuit.",
          "url": "https://stellaelectricllc.com/electrical-load-calculation/#step-3"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Add the nameplate loads of fixed appliances",
          "text": "Include the range, oven, dryer, water heater, dishwasher, disposal, well pump and any other fastened-in-place equipment at its nameplate rating.",
          "url": "https://stellaelectricllc.com/electrical-load-calculation/#step-4"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Apply the demand factors",
          "text": "The general lighting, small-appliance and laundry loads are totaled, then the first 3,000 VA counts at 100 percent and the remainder at 35 percent under the standard method. Ranges and dryers have their own demand tables.",
          "url": "https://stellaelectricllc.com/electrical-load-calculation/#step-5"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Add the larger of heating or cooling",
          "text": "Compare the air conditioning load against the electric heating load and include only the larger of the two, since they do not run at the same time.",
          "url": "https://stellaelectricllc.com/electrical-load-calculation/#step-6"
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Convert to amps and compare to the service",
          "text": "Divide the total volt-amperes by 240 to get the demand in amps, then compare that to the existing service. A result close to or above the service rating means the service needs to be upgraded before load is added.",
          "url": "https://stellaelectricllc.com/electrical-load-calculation/#step-7"
        }
      ]
    },
