    {
      "@type": "FAQPage",
      "@id": "https://stellaelectricllc.com/gfci-outlet-replacement/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/gfci-outlet-replacement/#faq-1",
          "name": "How often do GFCI outlets need to be replaced?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plan on roughly ten years, sooner in wet or outdoor locations. The protective electronics degrade even when the outlet still delivers power, which is why the test button matters more than whether the outlet works."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/gfci-outlet-replacement/#faq-2",
          "name": "How do I know if a GFCI outlet is bad?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It will not trip when you press TEST, it will not reset, it resets but delivers no power, or it trips constantly with nothing plugged in. GFCIs made since 2015 self-test and many indicate a failure with a light or by refusing to reset."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/gfci-outlet-replacement/#faq-3",
          "name": "Where are GFCI outlets required?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kitchens, bathrooms, garages, unfinished basements, crawlspaces, laundry areas, outdoors, and near sinks and wet locations generally. The list has grown with each code cycle, so an older home often needs GFCIs added in places that did not require them when it was built."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/gfci-outlet-replacement/#faq-4",
          "name": "Why does my GFCI keep tripping?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A tripping GFCI is usually reporting a real ground fault - moisture in an outdoor box, a failing appliance, a damaged cord, or a wiring fault downstream. Replacing the device without finding the fault just moves the problem. Unplug everything on the circuit and reset it; if it holds, add devices back one at a time."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/gfci-outlet-replacement/#faq-5",
          "name": "Should I replace a GFCI outlet myself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Swapping a device on an existing circuit is within reach for a confident homeowner, but the LINE and LOAD terminals are easy to reverse, and doing so silently leaves downstream outlets unprotected. If the GFCI keeps tripping, if the box has multiple cables, or if the wiring is aluminum or ungrounded, have an electrician handle it."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/gfci-outlet-replacement/#faq-6",
          "name": "Can a GFCI be installed on ungrounded wiring?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. A GFCI may replace an ungrounded two-prong receptacle and must be labeled No Equipment Ground. It protects people from shock, but it does not create a ground, so equipment needing a true ground still needs a grounded circuit."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://stellaelectricllc.com/gfci-outlet-replacement/#howto",
      "name": "How a GFCI Outlet Is Replaced",
      "description": "The steps involved in replacing a failed GFCI receptacle, and the wiring details that decide whether downstream outlets stay protected.",
      "totalTime": "PT30M",
      "image": {
        "@id": "https://stellaelectricllc.com/gfci-outlet-replacement/#primaryimage"
      },
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Confirm the GFCI has actually failed",
          "text": "Press TEST - the receptacle should trip and cut power - then RESET. A unit that will not trip, will not reset, or does not restore power has failed. A unit that trips repeatedly is reporting a ground fault somewhere on the circuit, and replacing it will not fix that.",
          "url": "https://stellaelectricllc.com/gfci-outlet-replacement/#step-1"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Shut off the circuit and verify",
          "text": "Switch off the breaker for the circuit and confirm the receptacle is dead with a non-contact voltage tester. Test both halves of the receptacle - some boxes carry more than one circuit.",
          "url": "https://stellaelectricllc.com/gfci-outlet-replacement/#step-2"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Note the LINE and LOAD wiring before removing anything",
          "text": "Pull the receptacle out and label which cable feeds it. LINE is the incoming supply; LOAD feeds downstream outlets that the GFCI also protects. Reversing them leaves the downstream outlets unprotected and can leave the device unable to reset.",
          "url": "https://stellaelectricllc.com/gfci-outlet-replacement/#step-3"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Transfer the wiring to the new device",
          "text": "Connect the incoming supply to the LINE terminals and the downstream cable to the LOAD terminals, matching hot, neutral and ground. Use the screw terminals rather than push-in connections, and do not remove the LOAD warning tape unless those terminals are being used.",
          "url": "https://stellaelectricllc.com/gfci-outlet-replacement/#step-4"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Seat the device and restore power",
          "text": "Fold the conductors carefully into the box, secure the receptacle, install the faceplate and switch the breaker back on.",
          "url": "https://stellaelectricllc.com/gfci-outlet-replacement/#step-5"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Test the device and everything downstream",
          "text": "Press TEST and RESET on the new device, then use a GFCI outlet tester on it and on every downstream outlet to confirm the protection follows the circuit as expected.",
          "url": "https://stellaelectricllc.com/gfci-outlet-replacement/#step-6"
        }
      ],
      "tool": [
        {
          "@type": "HowToTool",
          "name": "Non-contact voltage tester"
        },
        {
          "@type": "HowToTool",
          "name": "Screwdriver"
        },
        {
          "@type": "HowToTool",
          "name": "Wire strippers"
        },
        {
          "@type": "HowToTool",
          "name": "GFCI outlet tester"
        }
      ],
