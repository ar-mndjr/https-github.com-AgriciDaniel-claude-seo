    {
      "@type": "FAQPage",
      "@id": "https://stellaelectricllc.com/how-to-install-recessed-lighting/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/how-to-install-recessed-lighting/#faq-1",
          "name": "How many recessed lights do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Space the fixtures roughly half the ceiling height apart - about four feet on an eight-foot ceiling - and keep the outer row two to three feet off the walls. Adjust for the room's use: kitchens and work areas need more light on the counters, living spaces usually need less."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/how-to-install-recessed-lighting/#faq-2",
          "name": "What is the difference between IC-rated and non-IC-rated recessed lights?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "IC-rated housings are built to be covered by insulation. Non-IC housings must be kept clear of insulation, which makes IC-rated fixtures the right choice for any ceiling below an insulated attic."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/how-to-install-recessed-lighting/#faq-3",
          "name": "Can I replace old can lights with LED without rewiring?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In most cases yes. LED retrofit modules screw into or clip inside the existing housing and use the same wiring, and canless LED units can replace the housings entirely when you are opening the ceiling anyway."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/how-to-install-recessed-lighting/#faq-4",
          "name": "Do I need a permit to install recessed lighting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Adding a new circuit or extending wiring is permitted work in Maryland jurisdictions. Replacing existing fixtures in place generally is not, but your local permitting office has the final say."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/how-to-install-recessed-lighting/#faq-5",
          "name": "Why do my recessed LED lights flicker on the dimmer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Almost always a compatibility problem. LED fixtures need a dimmer listed for LED loads and a load within the dimmer's rated range, and mixing fixture types on one dimmer makes the flicker worse."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "https://stellaelectricllc.com/how-to-install-recessed-lighting/#howto",
      "name": "How to Install Recessed Lighting",
      "description": "The steps involved in laying out, wiring and installing recessed lights in a finished ceiling.",
      "totalTime": "{{HOWTO_TOTAL_TIME}}",
      "image": {
        "@id": "https://stellaelectricllc.com/how-to-install-recessed-lighting/#primaryimage"
      },
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Plan the layout",
          "text": "Space the lights evenly and keep them off the walls so the beams wash the room instead of the ceiling edge. A common starting point is spacing equal to half the ceiling height, with fixtures 24 to 36 inches from the walls, adjusted for work surfaces and furniture.",
          "url": "https://stellaelectricllc.com/how-to-install-recessed-lighting/#step-1"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Check what is above the ceiling",
          "text": "Locate joists, ductwork, plumbing and existing cable before cutting. Where the housings will contact insulation, use IC-rated fixtures; non-IC fixtures require clearance from insulation.",
          "url": "https://stellaelectricllc.com/how-to-install-recessed-lighting/#step-2"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Shut off and verify the power",
          "text": "Turn off the circuit at the panel and confirm the wires are dead with a non-contact voltage tester before opening any box or fixture.",
          "url": "https://stellaelectricllc.com/how-to-install-recessed-lighting/#step-3"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Cut the openings",
          "text": "Mark each location with the manufacturer's template and cut clean openings to size, checking again for obstructions as you go.",
          "url": "https://stellaelectricllc.com/how-to-install-recessed-lighting/#step-4"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Run the cable",
          "text": "Fish cable from the switch location through the ceiling to each opening, leaving enough slack at every hole to make up the connections comfortably.",
          "url": "https://stellaelectricllc.com/how-to-install-recessed-lighting/#step-5"
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Wire and set the fixtures",
          "text": "Connect each housing or canless unit to the cable, secure the cable in the connector, then set the fixture and let the spring clips grip the drywall.",
          "url": "https://stellaelectricllc.com/how-to-install-recessed-lighting/#step-6"
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Install the switch or dimmer",
          "text": "Terminate the switch leg at the wall box and install a dimmer that is listed as compatible with the LED fixtures, otherwise the lights will flicker or buzz at low output.",
          "url": "https://stellaelectricllc.com/how-to-install-recessed-lighting/#step-7"
        },
        {
          "@type": "HowToStep",
          "position": 8,
          "name": "Restore power, test and trim",
          "text": "Energize the circuit, test each fixture through the full dimming range, then install the trims and aim any adjustable units.",
          "url": "https://stellaelectricllc.com/how-to-install-recessed-lighting/#step-8"
        }
      ],
      "tool": [
        {
          "@type": "HowToTool",
          "name": "Drill"
        },
        {
          "@type": "HowToTool",
          "name": "Hole saw or drywall saw"
        },
        {
          "@type": "HowToTool",
          "name": "Stud finder"
        },
        {
          "@type": "HowToTool",
          "name": "Wire strippers"
        },
        {
          "@type": "HowToTool",
          "name": "Non-contact voltage tester"
        },
        {
          "@type": "HowToTool",
          "name": "Fish tape"
        }
      ],
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "Recessed housings or canless LED downlights"
        },
        {
          "@type": "HowToSupply",
          "name": "14/2 or 12/2 NM-B cable"
        },
        {
          "@type": "HowToSupply",
          "name": "Old-work cable clamps"
        },
        {
          "@type": "HowToSupply",
          "name": "Dimmer switch"
        },
        {
          "@type": "HowToSupply",
          "name": "Wire connectors"
        }
      ]
