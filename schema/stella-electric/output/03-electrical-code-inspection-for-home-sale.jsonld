    {
      "@type": "FAQPage",
      "@id": "https://stellaelectricllc.com/electrical-code-inspection-for-home-sale/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/electrical-code-inspection-for-home-sale/#faq-1",
          "name": "What is an electrical code inspection for a home sale?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a documented review of the home's electrical system by a licensed electrician before the property goes under contract. The inspection covers the panel and service, grounding and bonding, GFCI and AFCI protection, wiring condition, smoke alarms and any visible safety hazards, and it ends in a written report."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/electrical-code-inspection-for-home-sale/#faq-2",
          "name": "Why should a seller get an electrical inspection before listing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because a buyer's inspection that turns up unexpected damage can sink the sale or force a last-minute price concession. Finding the problems first lets you price the repairs, schedule them on your own timeline and hand buyers a report instead of a surprise."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/electrical-code-inspection-for-home-sale/#faq-3",
          "name": "What electrical problems come up most often in home inspections?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ungrounded two-prong outlets, missing GFCI protection in kitchens, baths, garages and outdoors, missing AFCI protection, double-tapped breakers, open splices and unsecured junction boxes, undersized or recalled panels, remaining knob-and-tube wiring, and smoke alarms that are missing, expired or not interconnected."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/electrical-code-inspection-for-home-sale/#faq-4",
          "name": "Does Maryland require smoke alarms to be updated before a sale?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Maryland law requires battery-only smoke alarms that are more than ten years old to be replaced with sealed ten-year lithium battery units, and hardwired alarms are still required where the code called for them. Alarm compliance is one of the first things flagged during a sale."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/electrical-code-inspection-for-home-sale/#faq-5",
          "name": "How long does an electrical code inspection take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A typical single-family home inspection takes a few hours on site, and the written report follows. The exact time depends on the size of the home, the number of panels and subpanels and how accessible the wiring is."
          }
        }
      ]
    },
