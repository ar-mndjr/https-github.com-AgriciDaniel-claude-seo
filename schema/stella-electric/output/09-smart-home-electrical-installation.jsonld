    {
      "@type": "FAQPage",
      "@id": "https://stellaelectricllc.com/smart-home-electrical-installation/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/smart-home-electrical-installation/#faq-1",
          "name": "Do smart switches need a neutral wire?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most do. Smart switches draw a small amount of power continuously to stay connected, and that requires a neutral in the switch box. Many older Baltimore-area homes have switch loops with no neutral, so an electrician either pulls a neutral or installs a no-neutral switch that is compatible with your fixtures."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/smart-home-electrical-installation/#faq-2",
          "name": "Do I need an electrical panel upgrade for a smart home?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Lights, switches and thermostats rarely change the load. A panel upgrade comes into play when you add high-draw equipment such as an EV charger, a heat pump or a smart panel with circuit-level monitoring, or when the existing panel is already full or undersized."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/smart-home-electrical-installation/#faq-3",
          "name": "Can I install smart devices myself?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plug-in devices and screw-in bulbs are homeowner-friendly. Anything wired into a box - switches, dimmers, fan controls, doorbell transformers, hardwired hubs - is licensed electrical work in Maryland and is worth having done by an electrician, particularly where the box has no neutral or the wiring is aluminum."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/smart-home-electrical-installation/#faq-4",
          "name": "What does a smart thermostat need to work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A C-wire that supplies continuous 24-volt power. If your thermostat cable does not have a spare conductor, the fix is either new cable to the air handler or a manufacturer-supplied power adapter at the equipment."
          }
        },
        {
          "@type": "Question",
          "@id": "https://stellaelectricllc.com/smart-home-electrical-installation/#faq-5",
          "name": "Should smart home devices be hardwired or wireless?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use wireless for convenience devices and hardwired connections for anything you depend on - cameras, automation hubs, access points and any device in a location with weak Wi-Fi. Hardwired network cable is the part that is far easier to install during a remodel than afterward."
          }
        }
      ]
    },
    {
      "@type": "ItemList",
      "@id": "https://stellaelectricllc.com/smart-home-electrical-installation/#itemlist",
      "name": "Smart home devices that need electrical work",
      "itemListOrder": "https://schema.org/ItemListOrderAscending",
      "numberOfItems": 7,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Smart switches and dimmers",
          "description": "Most require a neutral conductor in the switch box, which older homes often do not have."
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Smart thermostats",
          "description": "Need a common (C) wire for continuous power, which frequently means pulling new thermostat cable."
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Video doorbells",
          "description": "Need adequate transformer voltage and capacity; many older door chime transformers are undersized."
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Smart lighting and recessed fixtures",
          "description": "Need dimmers and drivers listed as compatible with the fixtures to avoid flicker."
        },
        {
          "@type": "ListItem",
          "position": 5,
          "name": "EV chargers",
          "description": "Need a dedicated 240-volt circuit and enough spare panel capacity."
        },
        {
          "@type": "ListItem",
          "position": 6,
          "name": "Smart panels and energy monitoring",
          "description": "Install at the electrical panel and often pair with a panel upgrade."
        },
        {
          "@type": "ListItem",
          "position": 7,
          "name": "Structured wiring and access points",
          "description": "Hardwired network cable gives automation hubs and cameras a connection that does not depend on Wi-Fi coverage."
        }
      ]
    },
