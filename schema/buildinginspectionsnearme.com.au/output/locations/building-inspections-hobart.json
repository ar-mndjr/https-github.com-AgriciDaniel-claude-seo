      "description": "Engineer-led building inspections across Hobart and Tasmania, carried out by Chartered Engineers and Licensed Builders. One inspection covers every report level, including engineering and dispute-ready reports.",
      "inLanguage": "en-AU",
      "isPartOf": {
        "@id": "https://buildinginspectionsnearme.com.au/#website"
      },
      "about": {
        "@id": "https://buildinginspectionsnearme.com.au/#organization"
