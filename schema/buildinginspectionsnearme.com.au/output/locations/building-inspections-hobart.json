        "@id": "https://buildinginspectionsnearme.com.au/building-inspections-hobart/#breadcrumb"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "@id": "https://buildinginspectionsnearme.com.au/building-inspections-hobart/#faq-1",
          "name": "Are your Hobart building inspectors qualified?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every Hobart inspection is carried out by a state-registered expert: a Chartered Engineer, a Licensed Builder, or both. Practitioner registration in Tasmania is administered by Consumer, Building and Occupational Services (CBOS). Because the inspection starts at engineer level, structural concerns can be assessed on the spot rather than referred to a separate engineering firm."
          }
        },
        {
          "@type": "Question",
          "@id": "https://buildinginspectionsnearme.com.au/building-inspections-hobart/#faq-2",
          "name": "How quickly can I get a building inspection in Hobart?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Same-week availability is standard in Hobart. Call 1800 796 776 or book online and we will confirm your inspection time."
          }
        },
        {
          "@type": "Question",
          "@id": "https://buildinginspectionsnearme.com.au/building-inspections-hobart/#faq-3",
          "name": "How much does a building inspection cost in Hobart?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "From $495 inc. GST for a three-bedroom home. Pricing depends on property size, type and the report level selected, and is confirmed before booking. Because every inspection starts at engineer level, there is no second inspection fee if you later need an engineering or dispute-level report."
          }
        },
        {
          "@type": "Question",
          "@id": "https://buildinginspectionsnearme.com.au/building-inspections-hobart/#faq-4",
          "name": "What does a pre-purchase building inspection cover in Hobart?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All accessible areas of the property: structural elements, roof space and roof covering, subfloor where accessible, external walls and cladding, internal walls and ceilings, windows and doors, wet areas, drainage and site conditions. Observations are documented with photographs and the report follows AS 4349.1."
          }
        },
        {
          "@type": "Question",
          "@id": "https://buildinginspectionsnearme.com.au/building-inspections-hobart/#faq-5",
          "name": "Can your report be used in TASCAT proceedings?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Reports are prepared by a Chartered Engineer to the evidentiary standard required for the Tasmanian Civil and Administrative Tribunal (TASCAT). Because the inspection data is captured at engineer level on the first visit, a standard report can be escalated to a dispute-ready expert report without a second inspection."
          }
        },
        {
          "@type": "Question",
          "@id": "https://buildinginspectionsnearme.com.au/building-inspections-hobart/#faq-6",
          "name": "Which suburbs and areas around Hobart do you cover?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We cover Hobart and the surrounding area, including Glenorchy, Moonah, Sandy Bay, Kingston, Bellerive and the greater Hobart area. If you are outside that area, call 1800 796 776 and we will confirm availability."
          }
        },
        {
          "@type": "Question",
          "@id": "https://buildinginspectionsnearme.com.au/building-inspections-hobart/#faq-7",
          "name": "What do Hobart's older homes and sloping sites mean for an inspection?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hobart combines a large stock of Georgian, Federation and weatherboard housing with steeply sloping sites. That produces a specific set of findings: rising damp in solid masonry, poor subfloor ventilation, cold-climate condensation and mould, and retaining wall and site drainage problems on sloping blocks. Retaining structures and slope stability are engineering questions, and are assessed as part of the inspection rather than referred out."
          }
        }
      ]
