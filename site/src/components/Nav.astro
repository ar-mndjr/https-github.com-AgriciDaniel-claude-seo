---
interface Props { active?: 'services' | 'about' | 'blog' | 'contact' | '' }
const { active = '' } = Astro.props;
const services = [
  { href: '/services/seo/', dot: 'var(--emerald)', title: 'SEO, GEO & AEO', text: 'Get found on Google and AI search' },
  { href: '/services/web-development/', dot: 'var(--indigo-l)', title: 'Web Development', text: 'Fast sites on any platform' },
  { href: '/services/ai-automation/', dot: 'var(--violet)', title: 'AI Automation', text: 'Busywork on autopilot' },
];
---
<header class="nav" id="nav">
  <div class="container">
    <div class="nav-inner">
      <a href="/" class="logo" aria-label="RankStruct home">
        <svg viewBox="0 0 290 350" aria-hidden="true"><use href="#logo" /></svg>
        RankStruct
      </a>
      <nav class="nav-links">
        <div class="dd">
          <a href="/#services" class:list={['dd-toggle', { active: active === 'services' }]} aria-haspopup="true">Services <svg width="12" height="12"><use href="#i-down" /></svg></a>
          <div class="dd-menu">
            {services.map((s) => (
              <a href={s.href}><i class="dot" style={`background:${s.dot}`}></i><span><b>{s.title}</b><small>{s.text}</small></span></a>
            ))}
          </div>
        </div>
        <a href="/#process">How We Work</a>
        <a href="/#cases">Case Studies</a>
        <a href="/about/" class:list={{ active: active === 'about' }}>About</a>
        <a href="/blog/" class:list={{ active: active === 'blog' }}>Blogs</a>
      </nav>
      <a href="/contact/" class="btn btn-primary">Contact Us</a>
      <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false"><svg width="18" height="18"><use href="#i-menu" /></svg></button>
    </div>
    <div class="mobile-menu" id="mobileMenu">
      <a href="/#services">Services</a>
      {services.map((s) => <a href={s.href} class="sub">{s.title}</a>)}
      <a href="/#process">How We Work</a>
      <a href="/#cases">Case Studies</a>
      <a href="/about/">About</a>
      <a href="/blog/">Blogs</a>
      <a href="/contact/" class="btn btn-primary">Contact Us</a>
    </div>
  </div>
</header>
