---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Glow from '../../components/Glow.astro';
import SecHead from '../../components/SecHead.astro';
import StepCards from '../../components/StepCards.astro';
import FaqList from '../../components/FaqList.astro';
import { serviceSchema, faqSchema } from '../../lib/schema';
import settings from '../../content/settings.json';
import process from '../../content/pages/industry-process.json';

export async function getStaticPaths() {
  const pages = await getCollection('industries', ({ data }) => import.meta.env.DEV || !data.draft);
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}
const { page } = Astro.props;
const d = page.data;
const split = !!d.highlight && d.title.includes(d.highlight);
const [before, after] = split ? d.title.split(d.highlight) : [d.title, ''];
const hasArrow = d.primary.label.trim().endsWith('→');
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'SEO Services', item: new URL('/services/seo/', settings.site_url).href },
    { '@type': 'ListItem', position: 2, name: d.name, item: new URL(`/seo/${page.id}/`, settings.site_url).href },
  ] };
// 7 services: last tile spans the full row so no tile is left alone
const lastWide = d.services.cards.length % 3 === 1;
---
<Layout title={d.seo.title} description={d.seo.description} active="services"
  schemas={[serviceSchema(d.name, d.seo.description), faqSchema(d.faq.items), breadcrumb]}>

  <section class="phero ind-hero">
    <Glow color="indigo" style="width:620px;height:460px;top:-160px;left:20%;" />
    <Glow color="green" drift="b" style="width:420px;height:420px;bottom:-200px;right:-100px;opacity:.5" />
    <Glow color="violet" drift="c" style="width:300px;height:300px;top:25%;right:15%;opacity:.35" />
    <div class="container reveal">
      <a href="/services/seo/" class="back"><svg><use href="#i-back" /></svg> SEO Services</a>
      <h1 class="h-xl">{d.label && <span class="eyebrow">{d.label}</span>}{before}{split && <span class="hl">{d.highlight}</span>}{after}</h1>
      <p class="lead">{d.text}</p>
      <div class="hero-cta">
        <a href={d.primary.url} class="btn btn-primary">{d.primary.label}{!hasArrow && <> <svg class="arrow"><use href="#i-arrow" /></svg></>}</a>
        <a href={d.secondary.url} class="btn btn-ghost">{d.secondary.label}</a>
      </div>
    </div>
  </section>

  <section class="psec ind-answer">
    <div class="container">
      <div class="card rank answer-box reveal">
        <span class="itile t-green"><svg><use href="#i-search" /></svg></span>
        <div><span class="mono">// Answer</span><h2>{d.answer.question}</h2><p>{d.answer.text}</p></div>
      </div>
    </div>
  </section>

  <section class="psec sec-deep">
    <Glow color="violet" style="width:420px;height:380px;top:10%;right:-120px;opacity:.35" />
    <div class="container">
      <SecHead title={d.why.title} text={d.why.text} />
      <div class="tiles t4 mt">
        {d.why.cards.map((k, i) => (
          <article class="card indigo tile reveal">
            <span class={`itile ${i % 2 ? 't-indigo' : 't-green'}`}><svg><use href={`#${k.icon}`} /></svg></span>
            <h3>{k.title}</h3><p>{k.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="psec">
    <Glow color="indigo" drift="c" style="width:520px;height:420px;top:15%;left:30%;opacity:.4" />
    <div class="container">
      <SecHead title={d.services.title} text={d.services.text} />
      <div class="tiles t3 mt">
        {d.services.cards.map((k, i) => (
          <article class:list={['card green tile reveal', { wide: lastWide && i === d.services.cards.length - 1 }]}>
            <div class="tile-top"><span class="itile t-green"><svg><use href={`#${k.icon}`} /></svg></span><span class="mono">{String(i + 1).padStart(2, '0')}</span></div>
            <h3>{k.title}</h3><p>{k.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="psec sec-deep">
    <Glow color="green" style="width:460px;height:400px;top:10%;left:-140px;opacity:.4" />
    <div class="container">
      <div class="ai-grid">
        <div class="reveal">
          <h2 class="h-lg">{d.ai.title}</h2>
          <p class="ai-text">{d.ai.text}</p>
          {d.ai.list_title && <h3 class="ai-list-title">{d.ai.list_title}</h3>}
          <ul class="ai-list">{d.ai.items.map((it) => <li><span class="tick"><svg><use href="#i-check" /></svg></span>{it}</li>)}</ul>
        </div>
        <div class="card struct ai-panel reveal" aria-hidden="true">
          <div class="code-top"><i class="dot" style="background:#f87171"></i><i class="dot" style="background:#f59e0b"></i><i class="dot" style="background:#4edea3"></i><span class="mono">ai_search.query</span></div>
          {(d.ai.prompts.length ? d.ai.prompts : [d.ai.items[0]]).map((q) => <div class="ai-q"><span class="mono">Prompt</span><p>“{q.replace(/[.?]$/, '')}{q.endsWith('?') ? '?' : ''}”</p></div>)}
          <div class="ai-a"><span class="mono">// Sources AI tools draw on</span>
            <div class="ai-srcs">{d.ai.items.map((it, i) => <span><i class="dot"></i>{String(i + 1).padStart(2, '0')}</span>)}</div>
            <div class="ai-lines"><i style="width:94%"></i><i style="width:82%"></i><i style="width:88%"></i><i style="width:60%"></i></div>
          </div>
        </div>
      </div>
      {d.callout && d.callout.text && (
        <div class="card rank note-bar big reveal"><svg><use href="#i-shield" /></svg><p><b>{d.callout.title}:</b> {d.callout.text}</p></div>
      )}
    </div>
  </section>

  {d.table && d.table.rows.length > 0 && (
    <section class="psec">
      <div class="container">
        <SecHead title={d.table.title} />
        <div class="card ptable reveal"><table class="compact">
          <thead><tr>{d.table.columns.map((c, i) => <th class={i === 1 ? 'hl-green' : i === 2 ? 'hl-indigo' : ''}>{c}</th>)}</tr></thead>
          <tbody>{d.table.rows.map((r) => <tr>{r.cells.map((c) => <td>{c}</td>)}</tr>)}</tbody>
        </table></div>
        {d.table.note && <p class="table-note mono">// {d.table.note}</p>}
      </div>
    </section>
  )}

  <section class="psec sec-deep" id="process">
    <Glow color="indigo" style="width:500px;height:400px;top:0;left:40%;opacity:.35" />
    <div class="container">
      <SecHead title={process.title} text={process.text} />
      <div class="tiles t4 mt"><StepCards steps={process.steps} accents={['green', 'indigo']} /></div>
    </div>
  </section>

  <section class="psec"><div class="container"><FaqList faq={{ ...d.faq, numbered: false }} accent="16,185,129" /></div></section>

  <section class="cta sec-deep" id="review">
    <div class="container">
      <div class="cta-box card struct cta-center reveal">
        <Glow color="indigo" style="width:520px;height:380px;bottom:-200px;left:30%;opacity:.8" />
        <h2>{d.cta.title}</h2>
        <p>{d.cta.text}</p>
        <form class="review-form" data-endpoint="/contact.php" data-kind="audit" data-fallback={settings.contact_email} novalidate>
          <input type="hidden" name="industry" value={d.name} />
          <label class="sr-only" for="r-site">Website URL</label>
          <input id="r-site" name="website" type="url" placeholder="https://yourcompany.com" required />
          <label class="sr-only" for="r-email">Work email</label>
          <input id="r-email" name="email" type="email" placeholder="you@yourcompany.com" required />
          <input type="text" name="company_website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit" class="btn btn-primary">{d.cta.button}</button>
          <span class="form-ok" role="status"></span>
        </form>
      </div>
      {d.related.length > 0 && (
        <nav class="related-links reveal" aria-label="Related">
          <span class="mono">Related:</span>
          {d.related.map((r) => <a href={r.url}>{r.label}</a>)}
        </nav>
      )}
    </div>
  </section>
</Layout>
