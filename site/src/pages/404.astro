---
import Layout from '../layouts/Layout.astro';
import Glow from '../components/Glow.astro';
---
<Layout title="Page not found — RankStruct" description="This page doesn't exist.">
  <section class="phero">
    <Glow color="indigo" style="width:600px;height:460px;top:-140px;left:25%;" />
    <div class="container reveal">
      <h1 class="h-xl"><span class="eyebrow">// Error_404</span>This page doesn't exist.</h1>
      <p class="lead">It may have moved, or the link may be wrong.</p>
      <div class="hero-cta"><a href="/" class="btn btn-primary">Back to Home</a><a href="/contact/" class="btn btn-ghost">Contact Us</a></div>
    </div>
  </section>
</Layout>
